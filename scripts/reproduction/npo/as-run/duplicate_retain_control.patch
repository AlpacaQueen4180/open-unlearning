diff --git a/src/data/collators.py b/src/data/collators.py
index 2acbe74..cad93e1 100644
--- a/src/data/collators.py
+++ b/src/data/collators.py
@@ -51,2 +51,29 @@ class DataCollatorForSupervisedDataset(object):
                     raise Warning(f"{self.index} not found in dataset")
         return return_dct
+
+
+class DuplicateRetainDataCollator(DataCollatorForSupervisedDataset):
+    """Emulate the released two-rank synchronized-retain sampling bug.
+
+    With per-rank batch four, both ranks draw the same four retain examples.
+    A single-device batch of eight therefore duplicates the first four collated
+    retain rows into the second four while leaving all forget rows distinct.
+    This is a diagnostic control, not a substitute for a two-GPU run.
+    """
+
+    def __call__(self, instances: Sequence[Dict]) -> Dict[str, torch.Tensor]:
+        batch = super().__call__(instances)
+        if "retain" not in batch:
+            return batch
+
+        retain_batch = batch["retain"]
+        batch_size = retain_batch["input_ids"].shape[0]
+        if batch_size % 2 != 0:
+            raise ValueError(
+                "DuplicateRetainDataCollator requires an even per-device batch size"
+            )
+        half = batch_size // 2
+        for key, value in retain_batch.items():
+            if torch.is_tensor(value) and value.shape[0] == batch_size:
+                value[half:] = value[:half].clone()
+        return batch
